# AGNES-BRIDGE — Claude Code ↔ Agnes AI 配置模板
# 运行配置落地路径：~/.cc-bridge/agnes.env（本模板首次使用时由框架自动复制到此处）
# ============================================================================
# 这是 Agnes AI 上游（agnes-bridge）的配置模板。首次运行 `cc-bridge agnes config`
# （或任何需要配置的 agnes 命令）时，桥会自动把本模板复制为 ~/.cc-bridge/agnes.env，
# CLI 从任意目录都能找到。每个上游一个独立配置文件（~/.cc-bridge/<upstream>.env），
# 互不干扰；多个上游想同时跑 daemon 时，各用不同的 PROXY_PORT。
#
# Agnes 官方提供 Anthropic 兼容端点 POST /v1/messages（认证 x-api-key +
# anthropic-version，支持流式 / tools / Anthropic 格式 thinking 字段；官方文档
# wiki.agnes-ai.com，2026-09-01 查证 + 本地实测）。本桥直接透传 Anthropic 格式请求。
#
#   API_BASE     : Agnes 的 Anthropic 兼容端点前缀。框架在它后面拼 /v1/messages，
#                  所以这里填裸域名（不带 /v1）：https://apihub.agnes-ai.com
#   UPSTREAM_PROXY : （境外上游通常需要）对上游端点的请求经此 HTTP 代理出站，如
#                  http://127.0.0.1:1087。Agnes 端点在境外，直连不通 / 不稳时配置；
#                  未配置则直连。配置后主转发与断流续写都走代理。
#   API_KEY_n    : Agnes 的 API KEY（platform.agnes-ai.com 创建），每个写成独立编号
#                  变量：API_KEY_1、API_KEY_2 …（推荐至少 2 个用于容灾）。某个 KEY
#                  被判失效 / 欠费（返回 401/403），或同 KEY 瞬态重试用尽时，桥自动
#                  切换下一个 KEY 重试——URL 不变，只换 KEY。每个 KEY 独立成行，方便
#                  上方注释标注账号来源、或整行注释掉临时禁用某 KEY。旧式
#                  API_KEY=k1,k2（逗号分隔）仍向后兼容，可与编号变量混用。
#   API_KEY_n_NAME / _PRIORITY / _HIDE_USER_ID : KEY 属性（统计展示名 / 优先级 /
#                  隐私选项），语义与其它上游模板一致。
#   MODEL_MAP    : 模型映射，格式「spoofA->targetA,spoofB->targetB」。左侧是 Claude
#                  白名单内的模型 ID，右侧是 Agnes 识别的真实模型名。支持多对；
#                  整个 MODEL_MAP 不写则用 adapter 默认单对
#                  claude-opus-4-8 → agnes-2.5-flash。
#
# 模型与价格（官方文档模型页，2026-09-01 查证；促销结束时间以平台公告为准）：
#   agnes-2.5-flash     上下文 512K / 最大输出 64K   当前 $0/1M（促销免费，标准价 $0.03/$0.15）
#   agnes-2.5-pro-beta  上下文 1M   / 最大输出 64K   $0.10/$0.30 每百万 tokens
#   agnes-2.5-pro       上下文 1M   / 最大输出 64K   $0.45/$0.90 每百万 tokens（cache $0.045）
#   （agnes-2.0-flash、agnes-2.5-pro-alpha 已官方废弃，勿用。）
# 注：思考等级不做桥接改写——Claude Code 的 /effort 档位原样透传。实测网关默认输出
# thinking 块（未请求思考也有），Claude Code 可正常处理。
#
#   PROXY_PORT   : 本地监听端口（多上游并存时各用不同端口）。
#   PROXY_LOG    : 1 = 记录每条请求（默认），0 = 静默。
#   PROXY_DUMP   : 1 = 把每个改写后的请求体落盘到 ~/.cc-bridge/dumps/（默认 0 关，调试用）。
# ============================================================================

# --- Agnes AI 上游 ---
API_BASE=https://apihub.agnes-ai.com
# Agnes 端点在境外，通常需要代理出站（本机代理地址按实际填；直连可用则删掉本行）：
UPSTREAM_PROXY=http://127.0.0.1:1087
# 两个 Agnes 的 KEY，每个独占一行（推荐）；一个不通自动切另一个。
# API Key 在 https://platform.agnes-ai.com/ 登录后创建。
# 账号 A 的 KEY（主力）
API_KEY_1=your_agnes_key_1
API_KEY_1_NAME=work
API_KEY_1_PRIORITY=10
# 账号 B 的 KEY（备用）
API_KEY_2=your_agnes_key_2
API_KEY_2_NAME=personal

# 模型映射（多对）：opus 走 pro、haiku / sonnet 走免费 flash。
MODEL_MAP=claude-opus-4-8->agnes-2.5-pro,claude-haiku-4-5->agnes-2.5-flash,claude-sonnet-5->agnes-2.5-flash

PROXY_PORT=8794
PROXY_LOG=1

# 调试用：PROXY_DUMP=1 会把每个改写后的请求体落盘到 ~/.cc-bridge/dumps/（用于验证适配
# 是否生效）。平时别开——每个请求同步写一个文件且不轮转，会拖慢转发、撑爆磁盘；排查完
# 务必改回并清空 dumps 目录。
# PROXY_DUMP=0

# --- CC 安全分类器路由（CC auto mode 的 security-monitor 请求）---
# 语义与其它上游一致：off = 桥直接伪造放行响应（默认，0 消耗）；on = 走下方 AGNES
# 免费模型判断。本上游本身就是 Agnes——开启分类器时 AGNES_API_KEY 可直接复用上面
# 的主力 KEY（同一个 key 值）。
CLASSIFIER_MODE=off
AGNES_API_BASE=https://apihub.agnes-ai.com/v1/chat/completions
AGNES_API_KEY=your_agnes_api_key
AGNES_MODEL_PRIMARY=agnes-2.5-flash
AGNES_MODEL_FALLBACK=agnes-2.0-flash
