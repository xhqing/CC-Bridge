# HYBRID-BRIDGE — Claude Code ↔ 多模型提供商混合桥 配置模板
# 运行配置落地路径：~/.cc-bridge/hybrid.env（本模板首次使用时由框架自动复制到此处）
# ============================================================================
# hybrid 是「混合上游」：一个本地端口同时服务多个模型提供商，按请求的模型路由到
# 对应提供商的端点 / KEY。比如同一个端口里：claude-opus-4-8 走 GLM、claude-haiku-4-5
# 走 Agnes——Claude Code 只配一个 ANTHROPIC_BASE_URL，切 /model 即切换背后的
# 提供商，不用换端口换配置。
#
# 配置按「成员分节」组织，每节前缀 = 成员名大写（成员必须是本框架已实现的上游：
# glm / ds / mimo / agnes，不能嵌套 hybrid 自身）。每节内变量语义与单上游桥的平铺写法
# 完全一致，只是多了节前缀：
#
#   <P>_BASES   : 该成员的多端点列表「名字->URL,…」（如 GLM 同时配 z.ai 国际版
#                 与智谱国内版）。单端点可写 <P>_BASE=URL（等价一个端点的 BASES）。
#   <P>_API_KEY_n : 该成员的 API KEY，节内编号变量（推荐至少 2 个用于容灾）。
#                 某个 KEY 失效 / 欠费（401/403）或瞬态重试用尽时，在本成员的
#                 KEY 里自动切换——不会跨成员切换（模型在别家不存在，切过去只会
#                 400）。
#   <P>_API_KEY_n_NAME / _BASE / _PRIORITY / _HIDE_USER_ID：KEY 属性，语义同平铺
#                 写法（统计展示名 / 绑定本节端点 / 优先级 / 隐私选项）。
#
# MODEL_MAP    : 模型映射，target 带「提供商:」前缀限定归属：
#                 spoofA->glm:glm-5.3,spoofB->ds:deepseek-v4-flash
#                 也可省略前缀（spoofA->glm-5.3）——桥在各成员的模型表里查这个
#                 模型名，恰好一家认识就自动限定为那家；没有一家认识或多家都认识
#                 （歧义）会在启动校验时报错，此时把前缀写全即可。
#                 注意：Claude Code 直发 target（不经 spoof）时也要带前缀才会被
#                 识别（如 /model 切到 glm:glm-5.3）；正常用 spoof 即可。
#
#   PROXY_PORT   : 本地监听端口（与其它上游并存时各用不同端口）。
#   PROXY_LOG    : 1 = 记录每条请求（默认），0 = 静默。
#   PROXY_DUMP   : 1 = 把每个改写后的请求体落盘到 ~/.cc-bridge/dumps/（默认 0 关，
#                  调试用，排查完务必改回并清空 dumps 目录）。
#
# ⚠️ 分节写法与平铺写法（API_BASES / API_KEY_n 直接写在顶层）不能混用——混用会
# 被启动校验拦下。安全分类器路由（CLASSIFIER_*）等全局变量仍写顶层，不分节。
# 分节变量只从配置文件读取（不支持用 shell 环境变量覆盖节内变量；顶层平铺变量
# 仍支持环境变量覆盖）。
# ============================================================================

# --- 成员 1：GLM（z.ai 国际版 + 智谱国内版双端点）---
GLM_BASES=zai->https://api.z.ai/api/anthropic,cn->https://open.bigmodel.cn/api/anthropic
# z.ai Coding Plan 账号 A（主力）
GLM_API_KEY_1=your_zai_key_1
GLM_API_KEY_1_NAME=zai-work
GLM_API_KEY_1_BASE=zai
GLM_API_KEY_1_PRIORITY=10
# 智谱（bigmodel.cn）账号 B（GLM 成员内容灾备用）
GLM_API_KEY_2=your_zhipu_key_2
GLM_API_KEY_2_NAME=zhipu-cn
GLM_API_KEY_2_BASE=cn

# --- 成员 2：Agnes AI（Anthropic 兼容端点，境外）---
# agnes-2.5-flash 当前促销免费（512K 窗口），默认接 haiku / sonnet 轻量角色（见
# 下方 MODEL_MAP）。端点在境外，直连不通 / 不稳时解开下方 UPSTREAM_PROXY 注释。
# API Key 在 https://platform.agnes-ai.com/ 创建。
AGNES_BASE=https://apihub.agnes-ai.com
AGNES_API_KEY_1=your_agnes_key_1

# --- 成员 3：DeepSeek（单端点）---
DS_BASE=https://api.deepseek.com/anthropic
DS_API_KEY_1=your_deepseek_key_1
DS_API_KEY_1_NAME=work

# --- 成员示例：小米 MiMo ---
# MIMO_BASE=https://api.mimo.xiaomi.com/anthropic
# MIMO_API_KEY_1=your_mimo_key_1

# --- 上游转发代理（可选，境外成员用）---
# 对所有成员上游端点的请求经此 HTTP 代理出站（主转发与断流续写都走）。未配置则
# 直连。⚠️ 全局生效：配了它，GLM 智谱国内版 / DeepSeek 等境内端点也会绕代理，
# 混合境内 + 境外成员时留意延迟影响。
# UPSTREAM_PROXY=http://127.0.0.1:1087

# 模型映射：opus-4-8 走 GLM 旗舰、opus-4-7 走 GLM flash、opus-4-6 走 DeepSeek
# flash、haiku / sonnet 走 Agnes 免费 flash。默认写法显式 provider；末对演示
# 省略前缀（agnes-2.5-flash 只有 Agnes 认识，恰好一家成员认识即自动限定为那家）。
MODEL_MAP=claude-opus-4-8->glm:glm-5.3,claude-opus-4-7->glm:glm-5.3-flash,claude-opus-4-6->ds:deepseek-v4-flash,claude-haiku-4-5->agnes:agnes-2.5-flash,claude-sonnet-5->agnes-2.5-flash

PROXY_PORT=8793
PROXY_LOG=1

# 调试用：PROXY_DUMP=1 会把每个改写后的请求体落盘到 ~/.cc-bridge/dumps/（用于验证
# 适配是否生效）。平时别开——每个请求同步写一个文件且不轮转，会拖慢转发、撑爆磁盘。
# PROXY_DUMP=0

# --- CC 安全分类器路由（CC auto mode 的 security-monitor 请求）---
# 与单上游桥语义相同：off = 桥直接伪造 <block>no</block> 放行（默认，0 消耗）；
# on = 走 AGNES 免费模型判断（需配 AGNES_API_KEY）。分类器请求不进成员路由。
CLASSIFIER_MODE=off
AGNES_API_BASE=https://apihub.agnes-ai.com/v1/chat/completions
AGNES_API_KEY=your_agnes_api_key
AGNES_MODEL_PRIMARY=agnes-2.5-flash
AGNES_MODEL_FALLBACK=agnes-2.0-flash
