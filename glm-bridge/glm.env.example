# GLM-BRIDGE — Claude Code ↔ GLM (z.ai) 配置模板
# 运行配置落地路径：~/.cc-bridge/glm.env（本模板首次使用时由框架自动复制到此处）
# ============================================================================
# 这是 GLM 上游（glm-bridge）的配置模板。首次运行 `cc-bridge glm config`（或任何
# 需要配置的 glm 命令）时，桥会自动把本模板复制为 ~/.cc-bridge/glm.env，CLI 从任意
# 目录都能找到。每个上游一个独立配置文件（~/.cc-bridge/<upstream>.env），互不干扰；
# 多个上游想同时跑 daemon 时，各用不同的 PROXY_PORT。
#
#   API_BASES    : 多端点列表，格式「名字->URL,名字->URL」。GLM 有两套端点：国际版
#                  z.ai（https://api.z.ai/api/anthropic）与国内版智谱（https://open.
#                  bigmodel.cn/api/anthropic）。配多端点后，每个 KEY 用 API_KEY_n_BASE
#                  绑定到某个端点（不绑则用第一个端点），KEY 轮换天然跨端点容灾——z.ai
#                  的 KEY 失效自动切到智谱的 KEY。只配一个端点时，写老式单变量
#                  API_BASE=URL 也完全兼容（等价于一个端点的 API_BASES）。
#   API_KEY_n    : API KEY，每个写成独立编号变量：API_KEY_1、API_KEY_2 …（推荐
#                  至少 2 个用于容灾）。某个 KEY 被判失效 / 欠费（返回 401/403），或同 KEY
#                  瞬态重试用尽时，桥自动切换下一个 KEY 重试。每个 KEY 独立成行，方便
#                  上方注释标注账号来源、或整行注释掉临时禁用某 KEY。旧式 API_KEY=k1,k2
#                  （逗号分隔）仍向后兼容，可与编号变量混用。
#   API_KEY_n_NAME : （可选）该 KEY 的统计展示名（如 zai-work / zhipu-cn）。配了名字，
#                  `cc-bridge stats` 的用量按 key-name 分类呈现（KEY 本身不显示）；不配
#                  则按 #n 展示。⚠️ 同一配置内 key-name 不允许重复（重复会在启动时被
#                  校验拦截——重名会把两个账号的用量混在一起）。
#   API_KEY_n_BASE : （可选）该 KEY 绑定的 API_BASES 端点名（如 zai / cn）。不绑则用
#                  第一个端点。绑不存在的端点名会被启动校验拦截。
#   API_KEY_n_PRIORITY : （可选）该 KEY 的优先级（非负整数，越大越先用）。配多个 KEY
#                  时，桥每次请求先用优先级最高的 KEY，它熔断 / 失效后才轮到低优先级
#                  KEY（同优先级按编号顺序）。全部不配则按编号顺序，行为与旧版一致。
#                  用途：主力 KEY 优先消耗、备用 KEY 只做容灾（主力恢复后自动回切——
#                  熔断到期即先用主力）。
#   API_KEY_n_HIDE_USER_ID : （可选，隐私选项）配 1 时该 KEY 转发的请求会清空
#                  metadata.user_id（Claude Code 自动附带的设备 / 会话标识）；不配或配 0
#                  则原样透传。适合不希望设备标识离开本机的隐私偏好，按 KEY 独立设置。
#   MODEL_MAP    : 模型映射，格式「spoofA->targetA,spoofB->targetB」。左侧是 Claude
#                  白名单内的模型 ID，右侧是 z.ai 识别的真实模型名。桥在
#                  转发前把 body.model 从左侧改写成右侧，上游永远看不到 spoof 值。
#                  支持多对：整个 MODEL_MAP 不写则用 adapter 默认
#                  单对 claude-opus-4-8 → glm-5.3。
#               
#   PROXY_PORT   : 本地监听端口（多上游并存时各用不同端口）。
#   PROXY_LOG    : 1 = 记录每条请求（默认），0 = 静默。
#   PROXY_DUMP   : 1 = 把每个改写后的请求体落盘到 ~/.cc-bridge/dumps/（默认 0 关，调试用）。
#
# 注：思考等级不做任何桥接改写——Claude Code 的 /effort 档位原样透传，GLM 端点按官方
# 映射表解读。CC /effort → GLM-5.3 实际思考等级的官方映射（智谱文档
# docs.bigmodel.cn/cn/guide/develop/claude，2026-08 版本，映射关系可能随 GLM 版本
# 更新而变化、以官方文档为准）：
#   CC 选 low / medium / high（CC 默认 high） → GLM high
#   CC 选 xhigh / max / ultracode             → GLM max
# CC 里 /effort 必须选一个值（不存在「不设置」），选了什么档就按上表映射——想始终
# max 就选 xhigh 或 max。
# ============================================================================

# --- GLM 上游（z.ai 国际版 + 智谱国内版双端点）---
# 两套端点同时配置：z.ai Coding Plan 与智谱开放平台。KEY 按账号来源绑定各自端点。
# 只用其中一套时，删掉另一条、并把不匹配的 KEY 整行注释掉即可。
API_BASES=zai->https://api.z.ai/api/anthropic,cn->https://open.bigmodel.cn/api/anthropic
# 每个 KEY 独占一行（推荐）；一个不通自动切另一个（跨端点容灾）。
# 在上方写注释标注账号来源；想临时停用某个 KEY，直接整行注释掉即可。
# KEY_NAME 是用量统计的展示名（cc-bridge stats 按 key-name 分类，不显示 KEY 本身），
# 同一配置内不能重复；KEY_BASE 把该 KEY 绑到上面 API_BASES 里的某个端点；KEY_PRIORITY
# 设优先级（越大越先用，主力 KEY 配大值、备用不配或配小值）。
# z.ai Coding Plan 账号 A（主力）
API_KEY_1=your_zai_key_1
API_KEY_1_NAME=zai-work
API_KEY_1_BASE=zai
API_KEY_1_PRIORITY=10
# 智谱（bigmodel.cn）账号 B（备用容灾）
API_KEY_2=your_zhipu_key_2
API_KEY_2_NAME=zhipu-cn
API_KEY_2_BASE=cn
# 示例：给某个 KEY 开启 user_id 隐藏（隐私偏好，按 KEY 独立设置）：
# API_KEY_2_HIDE_USER_ID=1
# 想加更多账号照此续写：API_KEY_3=…、API_KEY_3_NAME=…、API_KEY_3_BASE=…、API_KEY_3_PRIORITY=…

# 模型映射（多对）。glm-5.3 为 z.ai 当前旗舰（2026-08-14 发布）；Coding Plan 端点
# 已把 glm-5.2 / glm-5.1 的请求自动路由到 glm-5.3，旧值可继续写但建议直接用 5.3。
MODEL_MAP=claude-opus-4-8->glm-5.3,claude-haiku-4-5->glm-4.6,claude-sonnet-5->glm-4.7

PROXY_PORT=8788
PROXY_LOG=1

# 调试用：PROXY_DUMP=1 会把每个改写后的请求体落盘到 ~/.cc-bridge/dumps/（用于验证适配
# 是否生效）。平时别开——每个请求同步写一个文件且不轮转，会拖慢转发、撑爆磁盘；排查完
# 务必改回并清空 dumps 目录。
# PROXY_DUMP=0

# --- CC 安全分类器路由（CC auto mode 的 security-monitor 请求）---
# CC auto 模式下，主 agent 每次工具调用前都会发一个请求给安全分类器判断该动作是否该 block。
# 它高频（约是主对话请求数的 3 倍）且默认用 opus 倍率，是 z.ai Coding Plan 额度消耗的大头。
# 这里控制分类器请求怎么处理：
#   on  = 走下方 AGNES 免费模型判断（agnes-2.5-flash / agnes-2.0-flash，当前 $0/1M 免费促销）；
#         主模型请求失败立即切备用模型。需配 AGNES_API_KEY。
#   off = 桥直接伪造 <block>no</block> 放行响应，不走任何模型（0 消耗，但无安全判断——所有动作放行）。
# 未配置时默认 off。
CLASSIFIER_MODE=off
AGNES_API_BASE=https://apihub.agnes-ai.com/v1/chat/completions
AGNES_API_KEY=your_agnes_api_key
AGNES_MODEL_PRIMARY=agnes-2.5-flash
AGNES_MODEL_FALLBACK=agnes-2.0-flash
