# DS-BRIDGE — Claude Code ↔ DeepSeek 配置模板
# 运行配置落地路径：~/.cc-bridge/ds.env（本模板首次使用时由框架自动复制到此处）
# ============================================================================
# 这是 DeepSeek 上游（ds-bridge）的配置模板。首次运行 `cc-bridge ds config`（或任何
# 需要配置的 ds 命令）时，桥会自动把本模板复制为 ~/.cc-bridge/ds.env，CLI 从任意
# 目录都能找到。每个上游一个独立配置文件（~/.cc-bridge/<upstream>.env），互不干扰；
# 多个上游想同时跑 daemon 时，各用不同的 PROXY_PORT。
#
#   API_BASE     : DeepSeek 的 Anthropic 兼容接口地址（所有 KEY 共用同一个 URL）。
#                  本桥直接透传 Anthropic 格式请求到该端点，走 DeepSeek 隐式
#                  Context Caching（直传前缀稳定，缓存命中率高）。
#                  必须带 /anthropic 后缀：https://api.deepseek.com/anthropic
#   API_KEY_n    : DeepSeek 的 API KEY，每个写成独立编号变量：API_KEY_1、API_KEY_2 …（推荐
#                  至少 2 个用于容灾）。某个 KEY 被判失效 / 欠费（返回 401/403），或同 KEY
#                  瞬态重试用尽时，桥自动切换下一个 KEY 重试——URL 不变，只换 KEY。每个 KEY
#                  独立成行，方便上方注释标注账号来源、或整行注释掉临时禁用某 KEY。旧式
#                  API_KEY=k1,k2（逗号分隔）仍向后兼容，可与编号变量混用。
#   API_KEY_n_NAME : （可选）该 KEY 的统计展示名（如 work / personal）。配了名字，
#                  `cc-bridge stats` 的用量按 key-name 分类呈现（KEY 本身不显示）；
#                  不配则按 #n 展示。⚠️ 同一配置内 key-name 不允许重复（重复会在启动时
#                  被校验拦截——重名会把两个账号的用量混在一起）。
#   MODEL_MAP    : 模型映射，格式「spoofA->targetA,spoofB->targetB」。左侧是 Claude
#                  白名单内的模型 ID，右侧是 DeepSeek 识别的真实模型名。桥在
#                  转发前把 body.model 从左侧改写成右侧，上游永远看不到 spoof 值。
#                  支持多对：整个 MODEL_MAP 不写则用 adapter 默认
#                  单对 claude-opus-4-8 → deepseek-v4-pro。
#
#   PROXY_PORT   : 本地监听端口（多上游并存时各用不同端口）。
#   PROXY_LOG    : 1 = 记录每条请求（默认），0 = 静默。
#   PROXY_DUMP   : 1 = 把每个改写后的请求体落盘到 ~/.cc-bridge/dumps/（默认 0 关，调试用）。
#
# 注：每个 DeepSeek 模型的思考等级由下方 MODEL_THINKING 控制（max/high），按 target 模型
# 钉死、忽略 Claude Code 的 /effort 档位；未列出的模型走 MODEL_THINKING_DEFAULT（默认 max）。
# 取值含义：max=Think Max、high=Think High。
# ⚠️ 不要配 none（none=不思考只在 GLM 等认「不思考」的上游可用）：DeepSeek /anthropic
# 端点（本模板默认 API_BASE）的 output_config.effort 枚举只认 low/medium/high/xhigh/
# ultra/max，不认 none——MODEL_THINKING 配 none 会让请求 400（2026-08-10 实测），该端点
# 暂无法关闭思考，请只配 max / high。
# ============================================================================

# --- DeepSeek 上游 ---
API_BASE=https://api.deepseek.com/anthropic
# 两个 DeepSeek 的 KEY，每个独占一行（推荐）；一个不通自动切另一个。
# 在上方写注释标注账号来源；想临时停用某个 KEY，直接整行注释掉即可。
# KEY_NAME 是用量统计的展示名（cc-bridge stats 按 key-name 分类，不显示 KEY 本身），
# 同一配置内不能重复。
# 账号 A 的 KEY
API_KEY_1=your_deepseek_key_1
API_KEY_1_NAME=work
# 账号 B 的 KEY
API_KEY_2=your_deepseek_key_2
API_KEY_2_NAME=personal
# 想加更多账号照此续写：API_KEY_3=…、API_KEY_3_NAME=…

# 模型映射（多对）
MODEL_MAP=claude-opus-4-8->deepseek-v4-pro,claude-haiku-4-5->deepseek-v4-flash,claude-sonnet-5->deepseek-v4-flash

# 按模型思考等级（target 模型 -> 等级）：每个真实模型钉死一个思考等级，忽略 Claude Code
# 的 /effort 档位。取值：max（Think Max）/ high（Think High）。⚠️ 不要配 none：/anthropic
# 端点（本模板默认 API_BASE）的 output_config.effort 枚举不认 none，配了请求会 400
# （2026-08-10 实测），该端点暂无法关闭思考。默认全 max（保守）；需要降低思考开销时
# 可把某模型改配 high，例如 `deepseek-v4-flash->high`。
MODEL_THINKING=deepseek-v4-flash->max
MODEL_THINKING_DEFAULT=max

PROXY_PORT=8792
PROXY_LOG=1

# 调试用：PROXY_DUMP=1 会把每个改写后的请求体落盘到 ~/.cc-bridge/dumps/（用于验证适配
# 是否生效）。平时别开——每个请求同步写一个文件且不轮转，会拖慢转发、撑爆磁盘；排查完
# 务必改回并清空 dumps 目录。
# PROXY_DUMP=0

# --- CC 安全分类器路由（CC auto mode 的 security-monitor 请求）---
# CC auto 模式下，主 agent 每次工具调用前都会发一个请求给安全分类器判断该动作是否该 block。
# 它高频（约是主对话请求数的 3 倍），是 DeepSeek 额度消耗的大头。
# 这里控制分类器请求怎么处理：
#   on  = 走下方 AGNES 免费模型判断（agnes-2.5-flash / agnes-2.0-flash，当前 $0/1M 免费促销）；
#         主模型请求失败立即切备用模型。需配 AGNES_API_KEY。
#   off = 桥直接伪造 <block>no</block> 放行响应，不走任何模型（0 消耗，但无安全判断——所有动作放行）。
# 未配置时默认 off。
CLASSIFIER_MODE=off
AGNES_API_BASE=https://apihub.agnes-ai.com/v1/chat/completions
AGNES_API_KEY=your_agnes_api_key
AGNES_MODEL_PRIMARY=agnes-2.5-flash
AGNES_MODEL_FALLBACK=agnes-2.0-flash
